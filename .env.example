# Copy to .env (same directory) and fill in. .env is gitignored.
# Loaded automatically via python-dotenv by the API and the seed script, and by Vite for the VITE_ lines;
# no need to export anything. In production (Render) the same names are set as environment variables.
#
# Each user adds their own Stripe keys on the Settings page; they're stored encrypted in Postgres.
# Nothing here is a creator's key.

# --- Database ------------------------------------------------------------------------------------
# The docker-compose.yml Postgres. Create the tables with `cd backend && uv run alembic upgrade head`.
# Plain postgresql:// as hosts give it; the app switches the scheme to asyncpg itself.
DATABASE_URL=postgresql://stoke:stoke@127.0.0.1:5432/stoke

# --- Encryption of stored Stripe keys --------------------------------------------------------------
# local: a 32-byte key (64 hex characters). Required. BACK IT UP: without it, stored keys can't be read
# and every user has to add their keys again. Use a different one in production.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# aws_kms: production. The master key stays in AWS KMS; needs `uv sync --extra kms` and AWS credentials.
KEY_CIPHER=local
STOKE_ENCRYPTION_KEY=
AWS_KMS_KEY_ID=

# --- Sign-in (Auth0) ---------------------------------------------------------------------------------
# Your tenant's domain, and the identifier of the Auth0 API you created for Stoke (see the README).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.stoke.local
# The same values for the frontend, plus the Single Page Application's client ID. Vite only exposes
# VITE_ variables to the browser, and these aren't secrets. They're baked in at build time.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.stoke.local

# --- General -----------------------------------------------------------------------------------------
# Key for the opaque customer ids in profile URLs (an HMAC of the email). Required; generate it like
# STOKE_ENCRYPTION_KEY. BACK IT UP: changing it changes every customer link.
CUSTOMER_ID_SECRET=

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Host headers the API answers to (guards against DNS rebinding). Add your domain when deploying.
ALLOWED_HOSTS=127.0.0.1,localhost

# Seconds to cache Stripe reads in memory.
CACHE_TTL_SECONDS=300

# --- Local development only ----------------------------------------------------------------------
# Simulate creators with your own Connect platform: its connected accounts are added to EVERY signed-in
# user's view. Never set DEV_MODE in production. (STRIPE_API_KEY is accepted as the older name.)
DEV_MODE=false
STRIPE_PLATFORM_KEY=
# Optional comma-separated allowlist of connected accounts. Empty = every connected account.
STRIPE_ACCOUNT_IDS=
# Also aggregate charges made on the platform account itself.
INCLUDE_PLATFORM=true

# --- Seed script (backend/scripts/seed_test_data.py) -------------------------------------------------
# Local development only. TEST secret key with write access; the script refuses a live key.
STRIPE_SEED_KEY=sk_test_...
