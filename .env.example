# Copy to .env (same directory) and fill in. .env is gitignored.
# Loaded automatically via python-dotenv by the API and the seed script; no need to export anything.
#
# The API needs at least one of STRIPE_PLATFORM_KEY or STRIPE_ACCOUNT_KEYS. Both can be set together.
# Use restricted, read-only TEST keys (Dashboard -> Developers -> API keys -> Create restricted key)
# with Read access to: PaymentIntents, Invoices, Charges, Customers, Subscriptions, Balance transactions,
# and Accounts.

# --- Platform mode: you own the Connect platform ---------------------------------------------------
# Reads the platform account and every connected account (via the Stripe-Account header).
# (STRIPE_API_KEY is accepted as the older name for this setting.)
STRIPE_PLATFORM_KEY=rk_test_...

# Optional comma-separated allowlist of connected accounts. Empty = every connected account.
STRIPE_ACCOUNT_IDS=

# Also aggregate charges made on the platform account itself.
INCLUDE_PLATFORM=true

# --- Creator mode: a creator's own Stripe account (e.g. a Substack author) -------------------------
# Comma-separated keys, each issued from one creator's own Stripe account. This is the access you
# get from real creators, who don't own the platform.
STRIPE_ACCOUNT_KEYS=

# --- General -----------------------------------------------------------------------------------------
# Currency everything is converted to. Empty = the platform's payout currency, else the first account's.
REPORTING_CURRENCY=

# Key for the opaque customer ids in profile URLs (an HMAC of the email). Empty = a random key is
# generated on first run and kept in .customer_id_secret next to this file (gitignored). Set this
# instead where secrets come from the environment; changing it changes every customer link.
CUSTOMER_ID_SECRET=

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Seconds to cache Stripe reads in memory.
CACHE_TTL_SECONDS=300

# --- Seed script (backend/scripts/seed_test_data.py) -------------------------------------------------
# TEST secret key with write access. The script refuses to run with a live key.
STRIPE_SEED_KEY=sk_test_...
