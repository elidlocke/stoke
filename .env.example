# Copy to .env (same directory) and fill in. .env is gitignored.
# Loaded automatically via python-dotenv by the API and the seed script, and by Vite for the VITE_ lines;
# no need to export anything. In production (Render) the same names are set as environment variables.
#
# Each user connects their own Stripe accounts on the Settings page, by installing Stoke's Stripe App; its
# tokens are stored encrypted in Postgres. Nothing here is a creator's key.

# --- Database ------------------------------------------------------------------------------------
# The docker-compose.yml Postgres. Create the tables with `cd backend && uv run alembic upgrade head`.
# Plain postgresql:// as hosts give it; the app switches the scheme to asyncpg itself.
DATABASE_URL=postgresql://stoke:stoke@127.0.0.1:5432/stoke

# --- Encryption of stored Stripe secrets -----------------------------------------------------------
# local: a 32-byte key (64 hex characters). Required. BACK IT UP: without it, stored Stripe secrets can't be
# read and every user has to connect Stripe again. Use a different one in production.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# aws_kms: production. The master key stays in AWS KMS; needs `uv sync --extra kms` and AWS credentials.
KEY_CIPHER=local
STOKE_ENCRYPTION_KEY=
AWS_KMS_KEY_ID=

# --- Sign-in (Auth0) ---------------------------------------------------------------------------------
# Your tenant's domain, and the identifier of the Auth0 API you created for Stoke (see the README).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.stoke.local
# The same values for the frontend, plus the Single Page Application's client ID. Vite only exposes
# VITE_ variables to the browser, and these aren't secrets. They're baked in at build time.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.stoke.local

# --- Public site (site/) ---------------------------------------------------------------------------
# Where the app links for Privacy, Terms and Help, and where signing out lands (add it to Auth0's Allowed
# Logout URLs). Production: the stoke-site address in render.yaml. Empty: the app's own origin.
VITE_SITE_URL=http://localhost:4321
# Where the site's Sign in and Get started buttons go. Production: https://stoke-y4sf.onrender.com.
PUBLIC_APP_URL=https://localhost:5173

# --- Sending from Gmail ------------------------------------------------------------------------------
# A Google OAuth "Web application" client, for sending notes from each writer's Gmail (gmail.send only).
# See docs/gmail-setup.md. Its redirect URI must be CORS_ORIGIN + /api/gmail/callback. Empty: Gmail can't be connected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- General -----------------------------------------------------------------------------------------
# Key for the opaque customer ids in profile URLs (an HMAC of the email). Required; generate it like
# STOKE_ENCRYPTION_KEY. BACK IT UP: changing it changes every customer link.
CUSTOMER_ID_SECRET=

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=https://localhost:5173

# Host headers the API answers to (guards against DNS rebinding). Add your domain when deploying.
ALLOWED_HOSTS=127.0.0.1,localhost

# Seconds to cache reads of the stored Stripe data in memory.
CACHE_TTL_SECONDS=300

# --- Connecting Stripe (Stoke's Stripe App) -------------------------------------------------------
# Writers connect their Stripe accounts by installing Stoke's Stripe App. See docs/stripe-app-setup.md.
# The app's OAuth install link, from the app's External test tab in the Dashboard of the app's own account.
STRIPE_APP_INSTALL_URL=
# That account's secret key, in the same mode as the link (sk_test_ for the test-mode link). Empty: Stripe
# accounts can't be connected.
STRIPE_APP_SECRET_KEY=
# Signing secret of the webhook endpoint that keeps stored Stripe data current and reports uninstalls. Locally,
# use the secret `stripe listen --all-snapshot --forward-connect-to localhost:8000/api/stripe/webhook` prints (logged in to
# the app's account). On Render, the one backend/scripts/register_webhook.py prints. Empty: no webhooks
# (refresh still works).
STRIPE_WEBHOOK_SECRET=

# --- Seed script (backend/scripts/seed_test_data.py) -------------------------------------------------
# Local development only. TEST secret key with write access; the script refuses a live key.
STRIPE_SEED_KEY=sk_test_...
